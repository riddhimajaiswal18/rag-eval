# Qdrant Cloud
QDRANT_URL=https://YOUR-CLUSTER-URL
QDRANT_API_KEY=YOUR_QDRANT_API_KEY

# Collection
QDRANT_COLLECTION=qwen3_embeddings
# Optional isolated collection for PeerQA (defaults to peerqa_qwen3_embeddings)
QDRANT_COLLECTION_PEERQA=peerqa_qwen3_embeddings

# Embedding configuration
QDRANT_VECTOR_SIZE=4096
QDRANT_DISTANCE=Cosine
